# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority
# Get this from Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <password> with your database user's password and add a database name.
MONGODB_URI=mongodb+srv://krunal_borad_db_user:*******@cluster0.ly690pe.mongodb.net/bookmanager?retryWrites=true&w=majority&appName=Cluster

# Secret used to sign JWTs. Use a long random string in production.
# Generate one locally with: openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_secret

# How long login sessions last (used by both the JWT and the cookie)
JWT_EXPIRES_IN=7d
